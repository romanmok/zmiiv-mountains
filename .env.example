# Database (MariaDB via docker-compose, host port 3310)
DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=zmiiv_mountains
DB_USER=zmiiv_mountains
DB_PASSWORD=zmiiv_mountains_dev_pw
DB_ROOT_PASSWORD=root_dev_pw

# Public site URL (canonical, og:url). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Collectors (node-cron format). Default: every 30 minutes.
# CRON_TICK=*/30 * * * *

# Route photos/videos. Without S3_* files go to UPLOAD_DIR (default ./uploads) and are served by /media/*.
# UPLOAD_DIR=/var/www/zmiiv-mountains/uploads
# S3_BUCKET=green-flask-studio
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=zmiiv-mountains/
# S3_PUBLIC_BASE=https://eu2.contabostorage.com/80e5850c1d804562b4c76831edb9cdfb:green-flask-studio/zmiiv-mountains/
